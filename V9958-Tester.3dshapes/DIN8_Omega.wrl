#VRML V2.0 utf8

# Simple mechanical envelope for the Omega-compatible DIN-8 socket.  KiCad
# VRML coordinates are in legacy 0.1-inch units (1 unit = 2.54 mm).
Transform {
  translation 0 3.70 1.77
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.055 0.060 0.065
          specularColor 0.18 0.18 0.18
          shininess 0.35
        }
      }
      geometry Box { size 8.15 7.40 3.54 }
    }
  ]
}
